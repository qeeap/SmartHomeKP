@{
    ViewData["Title"] = "Создать сценарий";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Новый сценарий автоматизации</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Название сценария</label>
                        <input name="name" class="form-control" placeholder="Например: Проветривание" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Описание (необязательно)</label>
                        <input name="description" class="form-control" placeholder="Что делает сценарий" />
                    </div>

                    <h5 class="mt-4 mb-3 border-bottom pb-2">Условие (ЕСЛИ)</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Датчик</label>
                            <select name="sensorId" class="form-select" asp-items="ViewBag.Sensors" required>
                                <option value="">-- Выберите датчик --</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Оператор</label>
                            <select name="op" class="form-select" required>
                                <option value=">">></option>
                                <option value="<"><</option>
                                <option value=">=">>=</option>
                                <option value="<="><=</option>
                                <option value="==">==</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Порог</label>
                            <input name="threshold" type="number" step="0.1" class="form-control" required />
                        </div>
                    </div>

                    <h5 class="mt-4 mb-3 border-bottom pb-2">Действие (ТО)</h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Устройство</label>
                            <select name="deviceId" class="form-select" asp-items="ViewBag.Devices" required>
                                <option value="">-- Выберите устройство --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Команда</label>
                            <select name="commandType" class="form-select" required>
                                <option value="On">Включить</option>
                                <option value="Off">Выключить</option>
                                <option value="Toggle">Переключить</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success px-4">Создать сценарий</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>