@model IEnumerable<SmartHome.Domain.Entities.GuestPermission>
@{
    ViewData["Title"] = "Гостевой доступ";
}
@{
    var guests = ViewBag.Guests as Dictionary<int, string>;
    var devices = ViewBag.Devices as Dictionary<int, string>;
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Управление гостевым доступом</h2>
    <a asp-action="Create" class="btn btn-primary">+ Выдать доступ</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">Вы пока не выдавали доступ гостям.</div>
}
else
{
    <table class="table table-hover table-bordered shadow-sm mt-3">
        <thead class="table-dark">
            <tr>
                <th>Гость</th>
                <th>Статус</th>
                <th>Действует до</th>
                <th>Разрешенные устройства</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(guests.ContainsKey(item.GuestId) ? guests[item.GuestId] : "Неизвестно")</td>
                    <td>
                        @switch (item.Status)
                        {
                            case SmartHome.Domain.Enums.PermissionStatus.Active:
                                <span class="badge bg-success">Активно</span>
                                break;
                            case SmartHome.Domain.Enums.PermissionStatus.Suspended:
                                <span class="badge bg-warning text-dark">Приостановлено</span>
                                break;
                            case SmartHome.Domain.Enums.PermissionStatus.Expired:
                                <span class="badge bg-secondary">Истекло</span>
                                break;
                            case SmartHome.Domain.Enums.PermissionStatus.Revoked:
                                <span class="badge bg-danger">Отозвано</span>
                                break;
                        }
                    </td>
                    <td>@item.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (item.AllowedDeviceIds != null && item.AllowedDeviceIds.Any())
                        {
                            foreach (var id in item.AllowedDeviceIds)
                            {
                                if (devices.ContainsKey(id))
                                {
                                    <span class="badge bg-info text-dark me-1">@devices[id]</span>
                                }
                            }
                        }
                        else
                        {
                            <span class="text-muted">Нет устройств</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <form asp-action="Suspend" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-outline-warning" title="Приостановить">⏸</button>
                            </form>
                            <form asp-action="Resume" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-outline-success" title="Возобновить">▶</button>
                            </form>
                            <form asp-action="Renew" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-outline-primary" title="Продлить на 7 дней">🔄</button>
                            </form>
                            <form asp-action="Revoke" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger" title="Отозвать">✖</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
} 