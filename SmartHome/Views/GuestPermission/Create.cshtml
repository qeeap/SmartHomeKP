@{
    ViewData["Title"] = "Выдать гостевой доступ";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Новое разрешение</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Выберите гостя</label>
                        <select name="guestId" class="form-select" asp-items="ViewBag.Guests" required>
                            <option value="">-- Выберите пользователя --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Действует до</label>
                        <input type="datetime-local" name="expiresAt" class="form-control"
                               value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Разрешенные устройства</label>
                        <div class="border rounded p-3 bg-light" style="max-height: 250px; overflow-y: auto;">
                            @if (ViewBag.Devices != null && ViewBag.Devices.Count > 0)
                            {
                                foreach (var device in ViewBag.Devices)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedDeviceIds" value="@device.Id" id="dev_@device.Id">
                                        <label class="form-check-label" for="dev_@device.Id">
                                            @device.Name (@device.Type)
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">У вас пока нет активных устройств.</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success px-4">Выдать доступ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>