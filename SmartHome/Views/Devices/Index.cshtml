@model IEnumerable<SmartHome.Domain.Entities.Device>
@{
    ViewData["Title"] = "Мои устройства";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Мои устройства</h2>
    <a asp-action="Create" class="btn btn-primary">+ Добавить устройство</a>
    <a asp-action="Archive" class="btn btn-outline-secondary me-2">Архив</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        У вас пока нет активных устройств. Нажмите "Добавить устройство", чтобы начать.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var device in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@device.Name</h5>
                        @if (device.IsOnline)
                        {
                            <span class="badge bg-success">В сети</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не в сети</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="mb-1"><strong>Тип:</strong> @device.Type</p>
                        <p class="mb-1"><strong>Модель:</strong> @device.Model</p>
                        <p class="mb-3">
                            <strong>Комната:</strong>
                            @(device.Room != null ? device.Room.Name : "Не привязана")
                        </p>

                        <form asp-action="TogglePower" asp-route-id="@device.Id" method="post" class="mt-auto mb-2">
                            @if (device.PowerState)
                            {
                                <button type="submit" class="btn btn-success w-100">
                                    ⏻ Включено (Нажмите, чтобы выключить)
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    ⏻ Выключено (Нажмите, чтобы включить)
                                </button>
                            }
                        </form>

                        <form asp-action="Decommission" asp-route-id="@device.Id" method="post" onsubmit="return confirm('Вы уверены, что хотите снять устройство с учета? Оно исчезнет из списка, но история сохранится.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                🗑 Снять с учета
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}