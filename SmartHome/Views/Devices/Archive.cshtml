@model IEnumerable<SmartHome.Domain.Entities.Device>
@{
    ViewData["Title"] = "Архив устройств";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Архив устройств (снятые с учета)</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Назад к активным</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">В архиве пока нет устройств.</div>
}
else
{
    <table class="table table-hover shadow-sm">
        <thead class="table-secondary">
            <tr>
                <th>Название</th>
                <th>Тип</th>
                <th>Модель</th>
                <th>Комната</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Type</td>
                    <td>@item.Model</td>
                    <td>@(item.Room != null ? item.Room.Name : "Не привязана")</td>
                    <td><span class="badge bg-danger">Снято с учета</span></td>
                </tr>
            }
        </tbody>
    </table>
}