@model IEnumerable<SmartHome.Domain.Entities.Sensor>
@{
    ViewData["Title"] = "Мои датчики";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Мои датчики</h2>
    <a asp-action="Create" class="btn btn-primary">+ Добавить датчик</a>
</div>

<!-- Уведомления об успехе/ошибке -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        У вас пока нет датчиков. Добавьте первый, чтобы начать мониторинг.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var sensor in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@sensor.Name</h5>
                        @if (sensor.IsActive)
                        {
                            <span class="badge bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Отключен</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="mb-1"><strong>Тип:</strong> @sensor.Type</p>
                        <p class="mb-3">
                            <strong>Комната:</strong>
                            @(sensor.Room != null ? sensor.Room.Name : "Не привязана")
                        </p>

                        <!-- Последнее показание -->
                        <div class="text-center mb-3 p-3 bg-light rounded">
                            @{
                                var lastReading = sensor.Readings.OrderByDescending(r => r.Timestamp).FirstOrDefault();
                            }
                            @if (lastReading != null)
                            {
                                <h2 class="mb-0 text-primary">@lastReading.Value <small class="fs-6">@lastReading.Unit</small></h2>
                                <small class="text-muted">@lastReading.Timestamp.ToLocalTime().ToString("HH:mm:ss")</small>
                            }
                            else
                            {
                                <span class="text-muted">Нет данных</span>
                            }
                        </div>

                        <!-- Мини-список последних 3 замеров -->
                        <ul class="list-unstyled small text-muted mb-3">
                            @foreach (var r in sensor.Readings.OrderByDescending(r => r.Timestamp).Take(3))
                            {
                                <li>• @r.Value @r.Unit <span class="float-end">@r.Timestamp.ToLocalTime().ToString("HH:mm")</span></li>
                            }
                        </ul>

                        <!-- Кнопка вкл/выкл -->
                        <form asp-action="ToggleActive" asp-route-id="@sensor.Id" method="post" class="mt-auto mb-3">
                            <button type="submit" class="btn btn-sm @(sensor.IsActive ? "btn-outline-danger" : "btn-outline-success") w-100">
                                @(sensor.IsActive ? "Отключить датчик" : "Активировать датчик")
                            </button>
                        </form>

                        <!-- Форма симуляции -->
                        <form asp-action="SimulateReading" method="post" class="border-top pt-3">
                            <input type="hidden" name="sensorId" value="@sensor.Id" />
                            <div class="input-group input-group-sm">
                                <input type="number" step="0.1" name="value" class="form-control" placeholder="Значение" required />
                                <button type="submit" class="btn btn-primary" @(sensor.IsActive ? "" : "disabled")>Отправить</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}