@model SmartHome.Domain.Entities.Sensor
@{
    ViewData["Title"] = "Добавить датчик";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Новый датчик</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название датчика</label>
                        <input asp-for="Name" class="form-control" placeholder="Например: Датчик температуры" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Тип датчика</label>
                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<SmartHome.Domain.Enums.SensorType>()" required>
                            <option value="">-- Выберите тип --</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Unit" class="form-label">Единица измерения</label>
                        <input asp-for="Unit" class="form-control" placeholder="°C, %, лк или 0/1" required />
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label">Помещение</label>
                        <select asp-for="RoomId" class="form-select" asp-items="ViewBag.Rooms">
                            <option value="">-- Не привязано к комнате --</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Назад к списку</a>
                        <button type="submit" class="btn btn-success px-4">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}