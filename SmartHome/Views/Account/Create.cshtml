@{
    ViewData["Title"] = "Выдать доступ";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Новое разрешение</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label">Выберите гостя</label>
                        <select name="guestId" class="form-select" asp-items="ViewBag.Guests">
                            <option value="">-- Выберите пользователя --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Действует до</label>
                        <input type="datetime-local" name="expiresAt" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Разрешенные устройства</label>
                        <div class="border rounded p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var device in ViewBag.Devices)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="allowedDeviceIds" value="@device.Id" id="dev_@device.Id">
                                    <label class="form-check-label" for="dev_@device.Id">
                                        @device.Name (@device.Type)
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Выдать доступ</button>
                </form>
            </div>
        </div>
    </div>
</div>