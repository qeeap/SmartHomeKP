@model IEnumerable<SmartHome.Domain.Entities.Notification>
@{
    ViewData["Title"] = "Уведомления";
}

<h2 class="mt-4 mb-3">Уведомления</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">У вас пока нет уведомлений.</div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var item in Model)
        {
            <div class="list-group-item @(item.IsRead ? "list-group-item-light" : "list-group-item-primary")">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">@item.Subject</h5>
                    <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <p class="mb-1">@item.Text</p>
                @if (!item.IsRead)
                {
                    <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="mt-2">
                        <button type="submit" class="btn btn-sm btn-outline-success">Прочитано</button>
                    </form>
                }
            </div>
        }
    </div>
}