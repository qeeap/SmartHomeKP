@model SmartHome.Domain.Entities.Room
@{
    ViewData["Title"] = "Добавить помещение";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Новое помещение</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название комнаты</label>
                        <input asp-for="Name" class="form-control" placeholder="Например: Гостиная" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Floor" class="form-label">Этаж</label>
                        <input asp-for="Floor" class="form-control" type="number" value="1" required />
                        <span asp-validation-for="Floor" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Area" class="form-label">Площадь (кв.м)</label>
                        <input asp-for="Area" class="form-control" type="number" step="0.1" placeholder="Например: 25.5" required />
                        <span asp-validation-for="Area" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Назад к списку</a>
                        <button type="submit" class="btn btn-success px-4">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}