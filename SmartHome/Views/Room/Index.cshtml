@model IEnumerable<SmartHome.Domain.Entities.Room>
@{
    ViewData["Title"] = "Мои помещения";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Мои помещения</h2>
    <a asp-action="Create" class="btn btn-primary">+ Добавить комнату</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        У вас пока нет помещений. Создайте первую комнату, чтобы привязать к ней устройства.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var room in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@room.Name</h5>
                        <span class="badge bg-info text-dark">@room.Area м²</span>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><strong>Этаж:</strong> @room.Floor</p>

                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-secondary">Устройств: @room.Devices.Count</span>
                            <span class="badge bg-secondary">Датчиков: @room.Sensors.Count</span>
                        </div>

                        <div class="d-flex justify-content-between mt-auto">
                            <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@room.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}